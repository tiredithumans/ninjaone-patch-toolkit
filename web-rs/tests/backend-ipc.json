  "wording": {
    "calculationNotes": [
      [
        "Counted devices",
        "Online Windows, macOS and Linux devices in the selected scope. Offline devices are left out because their patch records may be out of date, and devices NinjaOne cannot patch (switches, printers, hypervisors, cloud monitors) have none, so neither is counted as clean."
      ],
      [
        "Pending",
        "A current patch record NinjaOne has not marked Installed or Rejected: awaiting approval, approved, failed, or with no status. Patch families counted: OS and third-party patches."
      ],
      [
        "Within SLA",
        "A counted device with no pending patch past its severity's SLA window."
      ],
      [
        "Fully patched",
        "A counted device with no pending patch at all, of any severity or age."
      ],
      [
        "Urgent",
        "Critical, Important and Security patches. NinjaOne grades most monthly security updates Security rather than Critical or Important."
      ],
      [
        "Past SLA",
        "Pending for longer than its severity's SLA window since first seen; a patch with no first-seen time counts as past SLA. SLA policy: 30 days (default); Critical 14 days, Important 30 days, Security 30 days, Moderate 60 days, Recommended 60 days, Low 90 days; no SLA: Optional. A severity with No SLA is never past SLA, but its patches still count as pending."
      ],
      [
        "First seen",
        "The earlier of NinjaOne's record time and when this app first saw the patch pending (this app's record began 2026-04-02 12:00 UTC); every pending record here is dated by NinjaOne's time."
      ],
      [
        "Approval columns",
        "NinjaOne's own workflow status, across every severity: Awaiting Approval waits on a person, Approved, Not Installed on the agent. A pending patch with neither status is in neither column."
      ],
      [
        "All organizations",
        "Every counted device once, so its percentages are not the average of the organization rows."
      ],
      [
        "Percentages",
        "To one decimal, and never rounded up to 100%: 99.96% shows as 99.9%."
      ]
