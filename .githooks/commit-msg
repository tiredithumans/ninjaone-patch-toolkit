#!/usr/bin/env bash
# Rejects a commit subject that is not Conventional Commits.
#
# The same rule as `.claude/hooks/conventional-commit-validator.sh`, but bound to
# git rather than to one editor. That hook is a PreToolUse hook registered in
# `.claude/settings.json`: it fires only inside a Claude Code session, so a human
# contributor, a `git commit` typed in a terminal, a different assistant, or a
# change to Claude Code's own hook payload schema all bypassed the format entirely
# with no signal. Keep both — the Claude hook catches it before the command runs,
# which is a faster loop; this one is the gate that always applies.
#
# Installed by `just setup` (sets core.hooksPath), and mirrored by the `commits`
# job in ci.yml so a contributor who never runs `just setup` is still caught.

set -uo pipefail

msg_file="${1:?commit-msg hook expects the message file as $1}"

# Comments and the diff git appends under --verbose are not the subject.
subject=$(grep -v '^#' "$msg_file" | sed -n '/[^[:space:]]/{p;q;}' | sed 's/^[[:space:]]*//')

# A merge, revert, fixup or squash subject is generated by git itself.
case "$subject" in
  "Merge "*|"Revert "*|"fixup!"*|"squash!"*|"amend!"*) exit 0 ;;
  "") exit 0 ;;
esac

if printf '%s' "$subject" \
  | grep -Eq '^(feat|fix|docs|chore|refactor|test|build|ci|perf|style|revert|deps)(\([^)]+\))?!?: .+$'; then
  exit 0
fi

cat >&2 <<MSG
[commit-msg] Subject does not match Conventional Commits.
  subject:  $subject
  expected: <type>[(scope)][!]: <description>
  types:    feat fix docs chore refactor test build ci perf style revert deps
  scopes:   desktop web api auth export filter settings ci docs
MSG
exit 1
